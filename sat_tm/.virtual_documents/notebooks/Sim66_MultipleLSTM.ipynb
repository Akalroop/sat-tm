    "total_train_time": total_train_time if "total_train_time" in locals() else 0.0,
    "seed": SEED,
    "threshold": threshold,
    "recall": recall,
    "precision": precision,
    "f1": f1,
}

master_csv = RESULTS_ROOT / "ablation_results.csv"
