import pandas as pd
from numpy.lib.stride_tricks import sliding_window_view

ev = pd.read_csv("../../../live_simulator/data_fixed/eval/anomaly_labels.csv")
print(len(ev), "events in eval")

missed = (valid_window_labels == 1) & (val_score < threshold)
n_anom_frames = sliding_window_view(valid_labels, WINDOW_SIZE).sum(axis=1)  # anomalous frames per window

print("missed:", missed.sum(), "of", valid_window_labels.sum())
print("anomalous frames inside missed windows:")
print(pd.Series(n_anom_frames[missed]).describe())

for _, e in ev.iterrows():
    lo = max(0, e.start_step - WINDOW_SIZE + 1)
    hi = min(len(missed) - 1, e.end_step - 1)
    print(f"event {e.event_id}: {e.type:8s} sev={e.severity} params={e.params[:45]:45s} "
          f"missed {missed[lo:hi+1].sum()}/{valid_window_labels[lo:hi+1].sum()}")






from sklearn.metrics import recall_score, precision_score, f1_score, confusion_matrix

recall = float(recall_score(test_window_labels, test_predictions))
precision = float(precision_score(test_window_labels, test_predictions))
f1 = float(f1_score(test_window_labels, test_predictions))
conf_matrix = confusion_matrix(test_window_labels, test_predictions)
prec_curve, rec_curve, pr_thresholds = precision_recall_curve(
    test_window_labels,
    test_score
)

print(f"Recall: {recall:.4f}")
print(f"Precision: {precision:.4f}")
print(f"F1-Score: {f1:.4f}")
print("Confusion Matrix:\n", conf_matrix)

plt.figure(figsize=(7, 5))
plt.plot(rec_curve, prec_curve, label=f"Precision-Recall Curve (Test F1={f1:.3f})")
plt.xlabel("Recall")
plt.ylabel("Precision")
plt.title("Precision-Recall Curve")
plt.legend()
plt.grid(True)
plt.savefig(RUN_DIR / 'pr_curve.png')
plt.show()

metrics = {
    "experiment_id": EXPERIMENT_ID,
    "baseline_id": BASELINE_ID,
    "threshold": float(threshold),
    "recall": float(recall),
    "precision": float(precision),
    "f1": float(f1),
    "confusion_matrix": conf_matrix.tolist(),
    "best_epoch": best_epoch,
    "best_val_loss": float(best_val_loss),
    "test_loss": float(test_pc_err.mean()),
    "total_train_time": float(total_train_time) if "total_train_time" in locals() else 0.0,
    "seed": SEED,
}
with open(RUN_DIR / "run_config.json", "w") as f:
    json.dump(cfg, f, indent=2)

with open(RUN_DIR / "metrics.json", "w") as f:
    json.dump(metrics, f, indent=2)

summary_row = {
    "experiment_id": EXPERIMENT_ID,
